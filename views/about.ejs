<!DOCTYPE html>
<html lang="en">
<head>
  <script>if(localStorage.getItem('darkMode')==='true')document.documentElement.classList.add('dark');</script>
  <meta charset="UTF-8">
<meta name="google-site-verification" content="QpMEQmZbbkF7CT-Jn0u6TQALwG0zIakc_le6AdARl7s">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>About — Snap & Snacks</title>
  <link rel="canonical" href="<%= siteUrl('/about') %>">
  <meta name="description" content="Travel, good food, and photographs from the road. Get to know the author of Snap &amp; Snacks.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="About — Snap &amp; Snacks">
  <meta property="og:description" content="Travel, good food, and photographs from the road. Get to know the author of Snap &amp; Snacks.">
  <meta property="og:url" content="<%= siteUrl('/about') %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/info-pages.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">


</head>
<body>

  <%- include('partials/nav', { active: 'about' }) %>

  <main class="info-page">
    <section class="about-intro" aria-labelledby="about-title">
      <div class="about-intro-copy">
        <p class="info-kicker">About Snap &amp; Snacks</p>
        <h1 id="about-title">Hey, I’m NonChalant.</h1>
        <p>I’m a traveller who believes the best way to understand a place is through its food.</p>
        <p>This blog started as a personal diary. It’s where I share the places, meals, and moments I want to remember.</p>
        <div class="info-actions">
          <a href="/blog" class="btn btn-accent">Read the stories ↗</a>
          <a href="/contact" class="info-text-link">Get in touch</a>
        </div>
      </div>
      <img src="/aswin.jpg" alt="Portrait of NonChalant, the author of Snap &amp; Snacks" class="about-intro-portrait" fetchpriority="high">
    </section>

    <section class="about-name" aria-labelledby="about-name-title">
      <h2 id="about-name-title">Why Snap &amp; Snacks?</h2>
      <p>Every trip has two things in common. I always have my camera, and I’m always hungry.</p>
    </section>

    <% if (stories.length) { %>
      <section aria-labelledby="about-stories">
        <div class="about-stories-heading">
          <h2 id="about-stories">Start here</h2>
          <a href="/gallery" class="info-text-link">See my photos ↗</a>
        </div>
        <div class="about-stories">
          <% for (const story of stories) { %>
            <article class="about-story">
              <a href="/post/<%= encodeURIComponent(story.slug) %>">
                <% if (story.image) { %>
                  <img src="<%= story.image %>" alt="" loading="lazy" decoding="async"
                    <%- responsiveImageAttributes(story.image, '(max-width: 640px) calc(100vw - 2rem), (max-width: 900px) 45vw, 360px') %>>
                <% } %>
                <div>
                  <p class="info-kicker"><%= story.category %></p>
                  <h3><%= story.title %></h3>
                </div>
              </a>
            </article>
          <% } %>
        </div>
      </section>
    <% } %>
  </main>

  <!-- Back to top -->
  <%- include('partials/footer') %>

  <script>
    <%- include('partials/dark-toggle-script') %>

<%- include('partials/cookie-script') %>

  </script>

<%- include('partials/cookie-banner') %>

</body>
</html>
