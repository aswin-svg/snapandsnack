<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="google-site-verification" content="QpMEQmZbbkF7CT-Jn0u6TQALwG0zIakc_le6AdARl7s">
  <title>Messages — Snap & Snack Admin</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/studio.css?v=workspace">
</head>
<body class="studio">
  <%- include('sidebar', { studioPage: 'messages' }) %>

  <div class="studio-main">
    <div style="margin-bottom:1.5rem">
      <h1>Contact messages</h1>
      <p style="color:#6b7280;font-size:0.9rem"><%= messages.length %> message<%= messages.length !== 1 ? 's' : '' %> received</p>
    </div>

    <% if (messages.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">📭</div>
        <p>No messages yet.</p>
      </div>
    <% } else { %>
      <div style="display:flex;flex-direction:column;gap:1rem">
        <% messages.forEach(msg => { %>
          <div class="message-card">
            <div class="message-header">
              <div class="comment-avatar" style="background:#5a67d8"><%= msg.name.charAt(0).toUpperCase() %></div>
              <div style="flex:1">
                <div style="font-weight:600;color:#1a1a1a"><%= msg.name %></div>
                <div style="font-size:0.82rem;color:#6b7280"><a class="studio-message-email" href="mailto:<%= encodeURIComponent(msg.email || '').replace(/%40/g, '@') %>"><%= msg.email %></a> · <%= msg.date %></div>
              </div>
              <form method="POST" action="/admin/messages/delete/<%= msg.id %>" onsubmit="return confirm('Delete this message?')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
              </form>
            </div>
            <p class="message-body"><%= msg.message %></p>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>
