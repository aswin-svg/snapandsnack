<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Snap &amp; Snacks Admin</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/studio.css">
</head>
<body class="studio">
  <aside class="studio-sidebar">
    <a class="studio-brand" href="/admin">Snap &amp; <span>Snacks</span></a>
    <nav aria-label="Admin navigation">
      <a href="/admin" aria-current="page">Dashboard</a>
      <a href="/admin/gallery">Gallery</a>
      <a href="/admin/newsletter">Newsletter</a>
      <a href="/admin/messages">Messages <% if (unreadMessages) { %><span class="studio-count"><%= unreadMessages %></span><% } %></a>
      <a href="/admin/password">Password</a>
      <a href="/admin/logout">Log out</a>
    </nav>
  </aside>

  <main class="studio-main">
    <header class="studio-header">
      <div>
        <p class="studio-kicker">Publishing</p>
        <h1>Dashboard</h1>
      </div>
      <div class="studio-actions">
        <a class="btn btn-outline" href="/" target="_blank" rel="noopener">View site ↗</a>
        <a class="btn btn-accent" href="/admin/new">+ New post</a>
      </div>
    </header>

    <dl class="studio-stats">
      <div><dt>Published posts</dt><dd><%= posts.length %></dd></div>
      <div><dt>Drafts</dt><dd><%= drafts.length %></dd></div>
      <div><dt>Gallery photos</dt><dd><%= photoCount %></dd></div>
      <div><dt>Unread messages</dt><dd><%= unreadMessages %></dd></div>
      <div><dt>Total views</dt><dd><%= posts.reduce((total, post) => total + (post.views || 0), 0).toLocaleString('en-US') %></dd></div>
    </dl>

    <% for (const section of [{ key: 'drafts', title: 'Drafts', entries: drafts, draft: true }, { key: 'published', title: 'Published posts', entries: posts, draft: false }]) { %>
      <section class="studio-panel" aria-labelledby="<%= section.key %>">
        <header class="studio-panel-header"><h2 id="<%= section.key %>"><%= section.title %></h2></header>
        <% if (!section.entries.length) { %>
          <p class="studio-empty"><%= section.draft ? 'No drafts yet.' : 'No published posts yet.' %></p>
        <% } else { %>
          <ul class="studio-list">
            <% for (const post of section.entries) { %>
              <li class="studio-entry">
                <div class="studio-entry-title">
                  <a href="<%= section.draft ? '/admin/preview/' + post.id : '/post/' + encodeURIComponent(post.slug) %>"><%= post.title %></a>
                  <p><%= post.category %> · <%= post.date %><%= post.pinned && !section.draft ? ' · Pinned' : '' %></p>
                </div>
                <div class="studio-actions">
                  <% if (section.draft) { %><a href="/admin/preview/<%= post.id %>" class="btn btn-outline btn-sm">Preview</a><% } %>
                  <a href="/admin/edit/<%= post.id %>" class="btn btn-outline btn-sm">Edit</a>
                  <% if (section.draft) { %>
                    <form method="POST" action="/admin/publish/<%= post.id %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-accent btn-sm">Publish</button>
                    </form>
                  <% } else { %>
                    <form method="POST" action="/admin/<%= post.pinned ? 'unpin' : 'pin' %>/<%= post.id %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-outline btn-sm"><%= post.pinned ? 'Unpin' : 'Pin' %></button>
                    </form>
                  <% } %>
                  <form method="POST" action="/admin/delete/<%= post.id %>" onsubmit="return confirm('Delete this post?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                  </form>
                </div>
              </li>
            <% } %>
          </ul>
        <% } %>
      </section>
    <% } %>

    <% const commented = posts.filter(post => post.comments?.length); %>
    <section class="studio-panel" aria-labelledby="comments">
      <header class="studio-panel-header"><h2 id="comments">Comments</h2></header>
      <% if (!commented.length) { %><p class="studio-empty">No comments yet.</p><% } %>
      <% for (const post of commented) { %>
        <div class="studio-comment-group">
          <h3><%= post.title %></h3>
          <% for (const comment of post.comments) { %>
            <article class="studio-comment">
              <div>
                <strong><%= comment.name %></strong>
                <span class="studio-comment-date"><%= comment.date %></span>
                <% if (comment.approved === false) { %><span class="studio-count">Pending</span><% } %>
                <p><%= comment.comment %></p>
                <% if (comment.reply) { %><p class="studio-reply">Reply: <%= comment.reply %></p><% } %>
              </div>
              <div class="studio-moderation">
                <form class="studio-reply-form" method="POST" action="/admin/comment/reply/<%= post.id %>/<%= comment.id %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="text" name="reply" placeholder="Write a reply…" aria-label="Reply to <%= comment.name %>">
                  <button type="submit" class="btn btn-outline btn-sm">Reply</button>
                </form>
                <div class="studio-actions">
                  <% if (comment.approved === false) { %>
                    <form method="POST" action="/admin/comment/approve/<%= post.id %>/<%= comment.id %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-accent btn-sm">Approve</button>
                    </form>
                  <% } %>
                  <form method="POST" action="/admin/comment/delete/<%= post.id %>/<%= comment.id %>" onsubmit="return confirm('Delete this comment?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                  </form>
                </div>
              </div>
            </article>
          <% } %>
        </div>
      <% } %>
    </section>

    <% if (posts.length) { %>
      <section class="studio-panel" aria-labelledby="views">
        <header class="studio-panel-header"><h2 id="views">Views on recent posts</h2></header>
        <% const maxViews = posts.reduce((max, post) => Math.max(max, post.views || 0), 1); %>
        <ul class="studio-list">
          <% for (const post of posts.slice(0, 8)) { %>
            <li class="studio-view">
              <a href="/post/<%= encodeURIComponent(post.slug) %>"><%= post.title %></a>
              <meter min="0" max="<%= maxViews %>" value="<%= post.views || 0 %>" aria-label="Views for <%= post.title %>"></meter>
              <strong><%= post.views || 0 %></strong>
            </li>
          <% } %>
        </ul>
      </section>
    <% } %>
  </main>
</body>
</html>
