<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Newsletter — Snap & Snacks Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">

  <nav class="admin-nav">
    <div class="admin-nav-inner">
      <div style="display:flex;align-items:center;gap:0.5rem">
        <a href="/" class="admin-logo">Snap &amp; <span>Snacks</span></a>
        <span class="admin-badge">Admin</span>
      </div>
      <div class="admin-nav-links">
        <a href="/admin" class="btn btn-outline btn-sm">← Dashboard</a>
        <a href="/admin/logout" class="btn btn-outline btn-sm">Log out</a>
      </div>
    </div>
  </nav>

  <div class="admin-main">
    <header class="subscriber-header">
      <h1>Newsletter subscribers</h1>
      <% if (subscribers.length) { %><a href="/admin/newsletter/export" class="btn btn-outline">Export CSV</a><% } %>
    </header>

    <% if (removed) { %><p class="alert" role="status">Subscriber removed.</p><% } %>

    <div class="dashboard-stats" style="grid-template-columns:repeat(1,1fr);max-width:300px">
      <div class="stat-card">
        <div class="stat-num"><%= subscribers.length %></div>
        <div class="stat-label">Total subscribers</div>
      </div>
    </div>

    <% if (subscribers.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">📭</div>
        <p>No subscribers yet.</p>
      </div>
    <% } else { %>
      <ul class="admin-table subscriber-list">
        <% for (const email of subscribers) { %>
          <li class="subscriber-row">
            <span><%= email %></span>
            <form method="POST" action="/admin/newsletter/remove" onsubmit="return confirm('Remove this email from the newsletter list?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="email" value="<%= email %>">
              <button type="submit" class="btn btn-danger btn-sm" aria-label="Remove <%= email %>">Remove</button>
            </form>
          </li>
        <% } %>
      </ul>
    <% } %>
  </div>

</body>
</html>
