<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
<meta name="google-site-verification" content="QpMEQmZbbkF7CT-Jn0u6TQALwG0zIakc_le6AdARl7s">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post ? 'Edit Post' : 'New Post' %> — Snap & Snack Admin</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/studio.css?v=workspace">
</head>
<body class="studio">
  <%- include('sidebar', { studioPage: 'editor' }) %>
  <main class="studio-main">
    <header class="studio-header">
      <div>
        <p class="studio-kicker">Publishing</p>
        <h1><%= post ? 'Edit post' : 'New post' %></h1>
      </div>
      <% if (post) { %>
        <div class="studio-actions">
          <span class="studio-count"><%= post.status === 'draft' ? 'Draft' : 'Published' %></span>
          <a class="btn btn-outline btn-sm" href="<%= post.status === 'draft' ? '/admin/preview/' + post.id : '/post/' + encodeURIComponent(post.slug) %>" target="_blank" rel="noopener">
            <%= post.status === 'draft' ? 'Preview saved draft ↗' : 'View published post ↗' %>
          </a>
        </div>
      <% } %>
    </header>

    <% if (error) { %><p class="alert alert-error" role="alert"><%= error %></p><% } %>
    <form method="POST" action="<%= (post ? '/admin/edit/' + post.id : '/admin/new') + '?_csrf=' + encodeURIComponent(csrfToken) %>"
      enctype="multipart/form-data" class="studio-editor" id="post-form" data-editor-id="<%= post ? post.id : 'new' %>">
      <input type="hidden" name="backupRevision">
      <div class="editor-recovery" id="editor-recovery" hidden>
        <p id="editor-recovery-message"></p>
        <button type="button" id="editor-restore" class="btn btn-outline btn-sm">Restore text</button>
        <button type="button" id="editor-discard" class="btn btn-outline btn-sm">Discard backup</button>
      </div>
      <div class="studio-editor-layout">
        <section class="studio-panel studio-editor-panel" aria-labelledby="write-heading">
          <h2 id="write-heading">Write</h2>
          <label for="post-title">Title</label>
          <input type="text" id="post-title" name="title" maxlength="160" placeholder="Give your story a title" required value="<%= post?.title || '' %>">
          <div class="studio-editor-label">
            <label for="content">Story</label>
            <span id="editor-word-count"></span>
          </div>
          <div class="editor-toolbar">
            <button type="button" onclick="insertTag('**','**')" aria-label="Bold" title="Bold"><b>B</b></button>
            <button type="button" onclick="insertTag('*','*')" aria-label="Italic" title="Italic"><i>I</i></button>
            <button type="button" onclick="insertTag('~~','~~')" aria-label="Strikethrough" title="Strikethrough"><s>S</s></button>
            <button type="button" onclick="insertLine('## ')" title="Heading 2">H2</button>
            <button type="button" onclick="insertLine('### ')" title="Heading 3">H3</button>
            <button type="button" onclick="insertLine('#### ')" title="Heading 4">H4</button>
            <button type="button" onclick="insertLine('> ')">Quote</button>
            <button type="button" onclick="insertLine('---')">Divider</button>
            <button type="button" onclick="insertLine('• ')" title="Bullet list">• List</button>
            <button type="button" onclick="insertLine('1. ')" title="Numbered list">1. List</button>
            <button type="button" onclick="insertLink()">Link</button>
            <button type="button" onclick="insertEmoji()">Emoji</button>
            <button type="button" onclick="toggleInlineUpload(this)" aria-controls="inline-upload-area" aria-expanded="false">Insert image</button>
          </div>
          <textarea id="content" name="content" rows="18" maxlength="100000" placeholder="Write your story here…" required><%= post?.content || '' %></textarea>
          <div class="inline-upload-area" id="inline-upload-area">
            <label for="inline-img-input">Insert a photo at the cursor</label>
            <input type="file" id="inline-img-input" accept="image/jpeg,image/png,image/webp" onchange="uploadInlineImage(this)">
            <p>Photos are uploaded when you save the post.</p>
            <div class="uploaded-inline-imgs" id="uploaded-inline-imgs"></div>
          </div>
          <div id="inline-img-inputs"></div>
        </section>
        <div class="studio-editor-settings">
          <section class="studio-panel studio-editor-panel" aria-labelledby="details-heading">
            <h2 id="details-heading">Story details</h2>
            <label for="post-category">Category</label>
            <select id="post-category" name="category">
              <% for (const category of [...new Set([...topics.map(topic => topic.name), post?.category].filter(Boolean))]) { %>
                <option value="<%= category %>" <%= post?.category === category ? 'selected' : '' %>><%= category %></option>
              <% } %>
            </select>
            <label for="post-tags">Tags <span class="form-hint">Separated by commas</span></label>
            <input type="text" id="post-tags" name="tags" maxlength="500" placeholder="Nepal, street food" value="<%= (post?.tags || []).join(', ') %>">
          </section>
          <section class="studio-panel studio-editor-panel" aria-labelledby="share-heading">
            <h2 id="share-heading">Image and sharing</h2>
            <label for="featured-image">Featured image <span class="form-hint">Up to 10 MB</span></label>
            <input type="file" id="featured-image" name="image" accept="image/jpeg,image/png,image/webp">
            <p class="editor-status" id="featured-image-status"></p>
            <figure class="editor-share-preview">
              <figcaption>Share preview</figcaption>
              <img id="editor-share-image" src="<%= post?.image || '/logo.png' %>" alt="Image used for the post’s share preview">
              <div>
                <small><%= new URL(siteUrl('/')).hostname %></small>
                <strong id="editor-share-title"><%= post?.metaTitle || post?.title || 'Post title' %></strong>
                <p id="editor-share-description"></p>
              </div>
            </figure>
            <details class="studio-seo">
              <summary>Search and sharing text</summary>
              <label for="post-meta-title">SEO title</label>
              <input type="text" id="post-meta-title" name="metaTitle" maxlength="70" placeholder="Defaults to the post title" value="<%= post?.metaTitle || '' %>">
              <label for="post-meta-description">Description</label>
              <textarea id="post-meta-description" name="metaDescription" maxlength="160" rows="3" placeholder="Defaults to the start of your story"><%= post?.metaDescription || '' %></textarea>
            </details>
          </section>
        </div>
      </div>
      <div class="studio-editor-actions">
        <p id="editor-save-status" class="editor-status" role="status">Use Save as draft or Publish post to save to the site.</p>
        <div class="studio-actions">
          <a href="/admin" class="btn btn-outline">Cancel</a>
          <button type="submit" name="action" value="draft" class="btn btn-outline">Save as draft</button>
          <button type="submit" name="action" value="publish" class="btn btn-accent"><%= post?.status === 'published' ? 'Update post' : 'Publish post' %></button>
        </div>
      </div>
    </form>
  </main>

  <script>
    // ─── Toolbar helpers ───────────────────────────────────────────
    function getTextarea() { return document.getElementById('content'); }

    function insertTag(before, after) {
      const ta = getTextarea();
      const start = ta.selectionStart, end = ta.selectionEnd;
      const selected = ta.value.substring(start, end) || 'text';
      const replacement = before + selected + after;
      ta.value = ta.value.substring(0, start) + replacement + ta.value.substring(end);
      ta.focus();
      ta.selectionStart = start + before.length;
      ta.selectionEnd   = start + before.length + selected.length;
      ta.dispatchEvent(new Event('input', { bubbles: true }));
    }

    function insertLine(prefix) {
      const ta = getTextarea();
      const start = ta.selectionStart;
      // find start of line
      const before = ta.value.lastIndexOf('\n', start - 1) + 1;
      ta.value = ta.value.substring(0, before) + '\n' + prefix + ta.value.substring(before);
      ta.focus();
      ta.selectionStart = ta.selectionEnd = before + prefix.length + 1;
      ta.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // ─── Inline image upload ───────────────────────────────────────
    function toggleInlineUpload(button) {
      const open = document.getElementById('inline-upload-area').classList.toggle('open');
      button.setAttribute('aria-expanded', String(open));
    }

    let inlineImgCounter = 0;

    function uploadInlineImage(input) {
      const file = input.files[0];
      if (!file) return;

      inlineImgCounter++;
      const fieldName = 'inline_image_' + inlineImgCounter;
      const tag = '[image:' + fieldName + ']';

      // Insert tag at cursor in textarea
      const ta = getTextarea();
      const pos = ta.selectionStart;
      ta.value = ta.value.substring(0, pos) + '\n' + tag + '\n' + ta.value.substring(pos);
      ta.focus();

      // Add hidden file input
      const hiddenInput = document.createElement('input');
      hiddenInput.type = 'file';
      hiddenInput.name = fieldName;
      hiddenInput.style.display = 'none';
      // Transfer the file using DataTransfer
      const dt = new DataTransfer();
      dt.items.add(file);
      hiddenInput.files = dt.files;
      document.getElementById('inline-img-inputs').appendChild(hiddenInput);
      ta.dispatchEvent(new Event('input', { bubbles: true }));

      // Show preview
      const reader = new FileReader();
      reader.onload = e => {
        const preview = document.createElement('div');
        preview.className = 'uploaded-inline-img';
        const image = document.createElement('img');
        image.src = e.target.result;
        image.alt = '';
        const label = document.createElement('span');
        label.textContent = file.name + ' → ' + tag;
        preview.append(image, label);
        document.getElementById('uploaded-inline-imgs').appendChild(preview);
      };
      reader.readAsDataURL(file);

      // Reset file input so same file can be re-selected
      input.value = '';
    }
//better text edior
     function insertLink() {
  const url = prompt('Enter URL:');
  if (!url) return;
  const text = prompt('Enter link text:') || url;
  const ta = getTextarea();
  const pos = ta.selectionStart;
  const link = '[' + text + '](' + url + ')';
  ta.value = ta.value.substring(0, pos) + link + ta.value.substring(pos);
  ta.focus();
  ta.dispatchEvent(new Event('input', { bubbles: true }));
}

function insertEmoji() {
  const emojis = ['😊','🌍','✈️','🍜','📷','🏔️','🌿','❤️','🔥','⭐','🎉','👋','🌸','🍕','🏖️','🎒','🗺️','☕','🌅','🙏'];
  const emoji = prompt('Pick an emoji:\n' + emojis.join(' '));
  if (!emoji) return;
  const ta = getTextarea();
  const pos = ta.selectionStart;
  ta.value = ta.value.substring(0, pos) + emoji + ta.value.substring(pos);
  ta.focus();
  ta.dispatchEvent(new Event('input', { bubbles: true }));
}

  </script>
  <script src="/js/post-editor.js?v=workspace" defer></script>

</body>
</html>
