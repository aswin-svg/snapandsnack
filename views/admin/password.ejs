<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="google-site-verification=QpMEQmZbbkF7CT-Jn0u6TQALwG0zIakc_le6AdARl7s">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change Password — Snap & Snack Admin</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/studio.css?v=workspace">
  <style>
    .pass-wrap { position: relative; }
    .pass-wrap input { padding-right: 2.5rem; }
    .pass-toggle {
      position: absolute; right: 10px; top: 50%;
      transform: translateY(-50%);
      background: none; border: none; cursor: pointer;
      font-size: 1.1rem; color: #9ca3af; padding: 0;
    }
    .pass-toggle:hover { color: #374151; }
  </style>
</head>
<body class="studio">

  <%- include('sidebar', { studioPage: 'password' }) %>

  <div class="studio-main">
    <header class="studio-header"><h1>Change password</h1></header>

    <% if (success) { %>
      <div style="background:#d1fae5;color:#065f46;border:1px solid #6ee7b7;padding:1rem;border-radius:8px;margin-bottom:1.5rem;font-size:0.95rem">
        ✅ Password changed successfully!
      </div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/admin/password" class="form-card" style="max-width:480px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label>Current password</label>
        <div class="pass-wrap">
          <input type="password" id="current" name="current" placeholder="Your current password" required>
          <button type="button" class="pass-toggle" onclick="togglePass('current', this)">👁️</button>
        </div>
      </div>
      <div class="form-group">
        <label>New password</label>
        <div class="pass-wrap">
          <input type="password" id="newpass" name="newpass" placeholder="At least 6 characters" required>
          <button type="button" class="pass-toggle" onclick="togglePass('newpass', this)">👁️</button>
        </div>
      </div>
      <div class="form-group">
        <label>Confirm new password</label>
        <div class="pass-wrap">
          <input type="password" id="confirm" name="confirm" placeholder="Type new password again" required>
          <button type="button" class="pass-toggle" onclick="togglePass('confirm', this)">👁️</button>
        </div>
      </div>
      <div class="form-actions">
        <a href="/admin" class="btn btn-outline">Cancel</a>
        <button type="submit" class="btn btn-accent">Save new password</button>
      </div>
    </form>
  </div>

  <script>
    function togglePass(id, btn) {
      const input = document.getElementById(id);
      if (input.type === 'password') {
        input.type = 'text';
        btn.textContent = '🙈';
      } else {
        input.type = 'password';
        btn.textContent = '👁️';
      }
    }
  </script>

</body>
</html>
