<!DOCTYPE html>
<html lang="en">
<head>
  <script>if(localStorage.getItem('darkMode')==='true')document.documentElement.classList.add('dark');</script>
  <meta charset="UTF-8">
<meta name="google-site-verification" content="QpMEQmZbbkF7CT-Jn0u6TQALwG0zIakc_le6AdARl7s">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gallery — Snap & Snack</title>
  <link rel="canonical" href="<%= siteUrl('/gallery') %>">
  <meta name="description" content="Photo gallery — moments captured from travels around the world by Aswin.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Gallery — Snap & Snacks">
  <meta property="og:description" content="Photo gallery — moments captured from travels around the world.">
  <meta property="og:url" content="<%= siteUrl('/gallery') %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/css/gallery.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>

  <%- include('partials/nav', { active: 'gallery' }) %>

  <div class="container">
    <div class="gallery-header">
      <h1>Photo Gallery</h1>
      <p>Moments captured from the road 📷 — <span id="photo-count"><%= photos.length %></span> photos</p>
    </div>

    <% if (photos.length > 0) { %>
    <div class="gallery-filter-bar">
      <button type="button" class="gallery-filter-btn active" data-gallery-filter="" aria-pressed="true">All</button>
      <%
        const allCaptions = photos.map(p => p.caption).filter(Boolean);
        const keywords = [...new Set(allCaptions.flatMap(c => c.split(/[,\s]+/).filter(w => w.length > 3)))].slice(0, 8);
        keywords.forEach(kw => {
      %>
        <button type="button" class="gallery-filter-btn" data-gallery-filter="<%= kw.toLowerCase() %>" aria-pressed="false"><%= kw %></button>
      <% }) %>
      <div class="gallery-search-box">
        <input type="search" id="gallery-search" placeholder="Search photos..." aria-label="Search photos">
      </div>
    </div>
    <% } %>
  </div>

  <% if (photos.length === 0) { %>
    <div class="container">
      <div class="empty-state">
        <div class="empty-icon">📷</div>
        <p>No photos yet — upload your first shots in the admin panel!</p>
        <a href="/admin/gallery" class="btn btn-accent">Upload photos</a>
      </div>
    </div>
  <% } else { %>

  <div class="portfolio" id="photo-grid">
    <% photos.forEach(photo => { %>
      <% const srcset = gallerySrcset(photo.src); %>
      <div class="project"
           data-caption="<%= photo.caption || '' %>"
           data-src="<%= photo.src %>">
        <img class="project__image" src="<%= photo.src %>"
          <% if (srcset) { %>srcset="<%= srcset %>" sizes="(max-width: 640px) 50vw, (max-width: 900px) 33vw, 25vw"
          onerror="this.onerror = null; this.removeAttribute('srcset')"<% } %>
          alt="<%= photo.caption || 'Travel photo' %>" loading="lazy" decoding="async">
        <% if (photo.caption) { %>
          <p class="project__tag"><%= photo.caption.split(',')[0] %></p>
          <h3 class="project__title"><%= photo.caption %></h3>
        <% } else { %>
          <p class="project__tag">📷</p>
          <h3 class="project__title">Travel photo</h3>
        <% } %>
        <div class="grid__overlay">
          <button type="button" class="view-btn" aria-haspopup="dialog">View photo</button>
        </div>
      </div>
    <% }) %>
  </div>

  <div id="no-results" style="display:none" class="container">
    <div class="empty-state">
      <div class="empty-icon">🔍</div>
      <p>No photos found.</p>
      <button type="button" class="btn btn-outline" id="gallery-reset">Show all</button>
    </div>
  </div>

  <% } %>

  <dialog class="lightbox-overlay" id="lightbox" aria-label="Gallery photo" aria-describedby="lightbox-caption">
    <div class="lightbox-inner">
      <button type="button" class="lightbox-close" aria-label="Close photo" autofocus>✕</button>
      <img id="lightbox-img" alt="">
      <div id="lightbox-caption" class="lightbox-caption"></div>
    </div>
  </dialog>

  <%- include('partials/footer') %>

  <script>
    const photoGrid = document.getElementById('photo-grid');
    if (photoGrid) {
      const lightbox = document.getElementById('lightbox');
      const image = document.getElementById('lightbox-img');
      const caption = document.getElementById('lightbox-caption');
      let opener;

      photoGrid.addEventListener('click', event => {
        const button = event.target.closest('.view-btn');
        if (!button) return;
        const photo = button.closest('.project');
        opener = button;
        image.src = photo.dataset.src;
        image.alt = photo.dataset.caption || 'Travel photo';
        caption.textContent = photo.dataset.caption;
        lightbox.showModal();
      });
      lightbox.querySelector('.lightbox-close').addEventListener('click', () => lightbox.close());
      lightbox.addEventListener('click', event => {
        if (event.target === lightbox) lightbox.close();
      });
      lightbox.addEventListener('close', () => {
        image.removeAttribute('src');
        opener?.focus();
      });

      const filters = [...document.querySelectorAll('[data-gallery-filter]')];
      const search = document.getElementById('gallery-search');
      const noResults = document.getElementById('no-results');
      const photoCount = document.getElementById('photo-count');
      const photos = photoGrid.querySelectorAll('.project');
      function showPhotos(query, activeFilter) {
        const keyword = query.trim().toLowerCase();
        for (const filter of filters) {
          filter.classList.toggle('active', filter === activeFilter);
          filter.setAttribute('aria-pressed', filter === activeFilter);
        }
        let visible = 0;
        for (const photo of photos) {
          const show = photo.dataset.caption.toLowerCase().includes(keyword);
          photo.style.display = show ? '' : 'none';
          if (show) visible++;
        }
        noResults.style.display = visible ? 'none' : 'block';
        photoCount.textContent = visible;
      }
      for (const filter of filters) {
        filter.addEventListener('click', () => {
          search.value = '';
          showPhotos(filter.dataset.galleryFilter, filter);
        });
      }
      search.addEventListener('input', () => showPhotos(search.value, null));
      document.getElementById('gallery-reset').addEventListener('click', () => {
        filters[0].click();
        filters[0].focus();
      });
    }

    <%- include('partials/dark-toggle-script') %>
    <%- include('partials/cookie-script') %>
  </script>

<%- include('partials/cookie-banner') %>

</body>
</html>
