<!DOCTYPE html>
<html lang="en">
<head>
  <script>if(localStorage.getItem('darkMode')==='true')document.documentElement.classList.add('dark');</script>
  <meta charset="UTF-8">
<meta name="google-site-verification" content="QpMEQmZbbkF7CT-Jn0u6TQALwG0zIakc_le6AdARl7s">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gallery — Snap & Snack</title>
  <link rel="canonical" href="<%= siteUrl('/gallery') %>">
  <meta name="description" content="Photo gallery — moments captured from travels around the world by Aswin.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Gallery — Snap & Snacks">
  <meta property="og:description" content="Photo gallery — moments captured from travels around the world.">
  <meta property="og:url" content="<%= siteUrl('/gallery') %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/gallery.css?v=photo-grid">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>

  <%- include('partials/nav', { active: 'gallery' }) %>

  <main class="gallery-page">
    <header class="gallery-heading">
      <div>
        <h1>Gallery</h1>
        <p>Places, plates, and moments from the road.</p>
      </div>
      <p id="photo-count" class="gallery-count" role="status"><%= photos.length %> <%= photos.length === 1 ? 'photo' : 'photos' %></p>
    </header>

    <% if (photos.length === 0) { %>
      <div class="empty-state">
        <p>No photos yet.</p>
      </div>
    <% } else { %>
      <div class="gallery-controls">
        <label class="gallery-search">
          <span aria-hidden="true">⌕</span>
          <input type="search" id="gallery-search" placeholder="Search photos" aria-label="Search photos">
        </label>
        <div class="gallery-filters" role="group" aria-label="Filter photos">
          <button type="button" data-gallery-filter="" aria-pressed="true">All photos</button>
          <%
            const words = photos.flatMap(photo => (photo.caption || '').split(/[,\s]+/)).filter(word => word.length > 3);
            const keywords = [...new Map(words.map(word => [word.toLowerCase(), word])).values()].slice(0, 8);
            for (const keyword of keywords) {
          %>
            <button type="button" data-gallery-filter="<%= keyword.toLowerCase() %>" aria-pressed="false"><%= keyword %></button>
          <% } %>
        </div>
      </div>

      <div class="gallery-grid" id="photo-grid">
        <% for (const photo of photos) { %>
          <% const srcset = gallerySrcset(photo.src); %>
          <figure class="gallery-tile" data-caption="<%= photo.caption || '' %>" data-src="<%= photo.src %>">
            <button type="button" class="gallery-open" aria-haspopup="dialog"
              aria-label="Open full-size photo: <%= photo.caption || photo.altText || 'Travel photo' %>">
              <span class="gallery-tile-image">
                <img src="<%= photo.src %>"
                  <% if (srcset) { %>srcset="<%= srcset %>" sizes="auto, (max-width: 640px) 50vw, (max-width: 900px) 45vw, 390px"
                  onerror="this.onerror = null; this.removeAttribute('srcset')"<% } %>
                  alt="<%= photo.altText || photo.caption || 'Travel photo' %>" loading="lazy" decoding="async">
                <span class="gallery-open-icon" aria-hidden="true">↗</span>
              </span>
              <span class="gallery-caption"><%= photo.caption || photo.altText || 'Travel photo' %></span>
            </button>
          </figure>
        <% } %>
      </div>

      <div id="no-results" class="empty-state" hidden>
        <p>No photos found.</p>
        <button type="button" class="btn btn-outline" id="gallery-reset">Show all</button>
      </div>
    <% } %>
  </main>

  <dialog class="lightbox-overlay" id="lightbox" aria-label="Gallery photo" aria-describedby="lightbox-caption">
    <div class="lightbox-inner">
      <button type="button" class="lightbox-close" aria-label="Close photo" autofocus>✕</button>
      <img id="lightbox-img" alt="">
      <div id="lightbox-caption" class="lightbox-caption"></div>
    </div>
  </dialog>

  <%- include('partials/footer') %>

  <script>
    const photoGrid = document.getElementById('photo-grid');
    if (photoGrid) {
      const lightbox = document.getElementById('lightbox');
      const image = document.getElementById('lightbox-img');
      const caption = document.getElementById('lightbox-caption');
      let opener;

      photoGrid.addEventListener('click', event => {
        const button = event.target.closest('.gallery-open');
        if (!button) return;
        const photo = button.closest('.gallery-tile');
        opener = button;
        image.src = photo.dataset.src;
        image.alt = photo.querySelector('img').alt;
        caption.textContent = photo.dataset.caption;
        lightbox.showModal();
      });
      lightbox.querySelector('.lightbox-close').addEventListener('click', () => lightbox.close());
      lightbox.addEventListener('click', event => {
        if (event.target === lightbox) lightbox.close();
      });
      lightbox.addEventListener('close', () => {
        image.removeAttribute('src');
        opener?.focus();
      });

      const filters = [...document.querySelectorAll('[data-gallery-filter]')];
      const search = document.getElementById('gallery-search');
      const noResults = document.getElementById('no-results');
      const photoCount = document.getElementById('photo-count');
      const photos = photoGrid.querySelectorAll('.gallery-tile');
      function showPhotos(query, activeFilter) {
        const keyword = query.trim().toLowerCase();
        for (const filter of filters) {
          filter.setAttribute('aria-pressed', filter === activeFilter);
        }
        let visible = 0;
        for (const photo of photos) {
          const text = photo.dataset.caption + ' ' + photo.querySelector('img').alt;
          const show = text.toLowerCase().includes(keyword);
          photo.hidden = !show;
          if (show) visible++;
        }
        noResults.hidden = visible > 0;
        photoCount.textContent = visible + (visible === 1 ? ' photo' : ' photos');
      }
      for (const filter of filters) {
        filter.addEventListener('click', () => {
          search.value = '';
          showPhotos(filter.dataset.galleryFilter, filter);
        });
      }
      search.addEventListener('input', () => showPhotos(search.value, null));
      document.getElementById('gallery-reset').addEventListener('click', () => {
        filters[0].click();
        filters[0].focus();
      });
    }

    <%- include('partials/dark-toggle-script') %>
    <%- include('partials/cookie-script') %>
  </script>

<%- include('partials/cookie-banner') %>

</body>
</html>
