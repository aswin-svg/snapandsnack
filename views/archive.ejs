<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="google-site-verification" content="QpMEQmZbbkF7CT-Jn0u6TQALwG0zIakc_le6AdARl7s">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Archive — Snap & Snacks</title>
  <meta name="description" content="Browse all posts by month and year on Snap & Snacks.">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-logo">Snap &amp; <span>Snacks</span></a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
        <a href="/gallery">Gallery</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <div class="toggle-track" id="dark-toggle" onclick="toggleDark()" title="Toggle dark mode">
          <div class="toggle-thumb" id="toggle-thumb">☀️</div>
        </div>
      </div>
      <button class="nav-hamburger" onclick="toggleMenu()">☰</button>
    </div>
    <div class="nav-mobile" id="nav-mobile">
      <a href="/">Home</a>
      <a href="/blog">Blog</a>
      <a href="/gallery">Gallery</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </div>
  </nav>

  <div class="container">
    <div class="blog-header">
      <h1>📅 Archive</h1>
      <p style="color:var(--muted);font-weight:300">Browse posts by month and year</p>
    </div>

    <% if (Object.keys(archive).length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">📅</div>
        <p>No posts yet.</p>
        <a href="/blog" class="btn btn-accent">Browse all posts</a>
      </div>
    <% } else { %>
      <div class="archive-list">
        <% Object.entries(archive).forEach(([month, posts]) => { %>
          <div class="archive-month">
            <div class="archive-month-header">
              <h2><%= month %></h2>
              <span class="archive-count"><%= posts.length %> post<%= posts.length !== 1 ? 's' : '' %></span>
            </div>
            <div class="archive-posts">
              <% posts.forEach(post => { %>
                <a href="/post/<%= post.slug %>" class="archive-post-item">
                  <% if (post.image) { %>
                    <img src="<%= post.image %>" alt="<%= post.title %>">
                  <% } else { %>
                    <div class="archive-post-placeholder">📷</div>
                  <% } %>
                  <div class="archive-post-info">
                    <span class="cat-badge cat-<%= post.category.toLowerCase() %>"><%= post.category %></span>
                    <h3><%= post.title %></h3>
                    <div style="display:flex;gap:1rem;font-size:0.8rem;color:var(--muted);margin-top:0.25rem">
                      <span><%= post.date %></span>
                      <span>⏱️ <%= Math.max(1, Math.round(post.content.split(/\s+/).length / 200)) %> min read</span>
                      <span>👁️ <%= post.views || 0 %> views</span>
                    </div>
                  </div>
                  <span class="archive-arrow">→</span>
                </a>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <button class="back-to-top" id="back-to-top" onclick="scrollToTop()" title="Back to top">↑</button>

  <footer class="footer">
    <div class="container">
      <div class="footer-bottom">© <%= new Date().getFullYear() %> Snap & Snacks</div>
    </div>
  </footer>

  <script>
    function toggleMenu() { document.getElementById('nav-mobile').classList.toggle('open'); }
    window.addEventListener('scroll', () => {
      document.getElementById('back-to-top').classList.toggle('visible', window.scrollY > 300);
    });
    function scrollToTop() { window.scrollTo({ top: 0, behavior: 'smooth' }); }
    function toggleDark() {
      document.documentElement.classList.toggle('dark');
      const isDark = document.documentElement.classList.contains('dark');
      localStorage.setItem('darkMode', isDark);
      document.getElementById('dark-toggle').classList.toggle('on', isDark);
      document.getElementById('toggle-thumb').textContent = isDark ? '🌙' : '☀️';
    }
    if (localStorage.getItem('darkMode') === 'true') {
      document.documentElement.classList.add('dark');
      document.getElementById('dark-toggle').classList.add('on');
      document.getElementById('toggle-thumb').textContent = '🌙';
    }
  </script>

</body>
</html>