<!DOCTYPE html>
<html lang="en">
<head>
  <script>if(localStorage.getItem('darkMode')==='true')document.documentElement.classList.add('dark');</script>
  <meta charset="UTF-8">
  <meta name="google-site-verification" content="QpMEQmZbbkF7CT-Jn0u6TQALwG0zIakc_le6AdARl7s">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Snap &amp; Snacks — Travel, Food &amp; Lifestyle</title>
  <link rel="canonical" href="<%= siteUrl('/') %>">
  <meta name="description" content="A travel, food and lifestyle blog by Aswin. Real stories, honest food reviews and photos from around the world.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Snap &amp; Snacks — Travel, Food &amp; Lifestyle">
  <meta property="og:description" content="A travel, food and lifestyle blog. Real stories, honest food reviews and photos from around the world.">
  <meta property="og:url" content="<%= siteUrl('/') %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/journal.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body class="journal">
  <%- include('partials/nav', { active: 'home' }) %>
  <% const featured = posts[0]; const recent = posts.slice(1, 7); %>
  <% const cover = featured?.image || '/gallery-uploads/rara2.JPG'; const coverSet = gallerySrcset(cover); %>
  <main class="journal-main">
    <section class="journal-hero" aria-labelledby="journal-title">
      <div class="journal-cover">
        <img src="<%= cover %>" alt="<%= featured?.image ? featured.title : 'Rara Lake, Nepal' %>"
          <% if (coverSet) { %>srcset="<%= coverSet %>" sizes="(max-width: 1360px) 100vw, 1320px"
          onerror="this.onerror = null; this.removeAttribute('srcset')"<% } %> fetchpriority="high">
      </div>
      <div class="journal-intro">
        <p class="journal-kicker">Travel · Food · Lifestyle</p>
        <h1 id="journal-title">Good food.<br>Great places.</h1>
        <p class="journal-description">Travel stories, favorite meals, and photographs from the road.</p>
        <form class="journal-search" action="/blog" method="GET" role="search">
          <input type="search" name="search" aria-label="Search stories" placeholder="Search places, food, and stories">
          <button class="journal-button" type="submit">Search</button>
        </form>
        <% if (featured) { %>
          <a class="journal-featured-link" href="/post/<%= encodeURIComponent(featured.slug) %>">
            <%= featured.title %> <span aria-hidden="true">↗</span>
          </a>
        <% } %>
      </div>
    </section>

    <nav class="journal-topics" aria-label="Explore by topic">
      <a href="/blog?category=Travel">Travel <span aria-hidden="true">↗</span></a>
      <a href="/blog?category=Food">Food <span aria-hidden="true">↗</span></a>
      <a href="/blog?category=Lifestyle">Lifestyle <span aria-hidden="true">↗</span></a>
      <a href="/gallery">Photography <span aria-hidden="true">↗</span></a>
    </nav>

    <% if (recent.length) { %>
    <section class="journal-section" aria-labelledby="recent-stories">
      <div class="journal-section-heading">
        <h2 id="recent-stories">Recent stories</h2>
        <a href="/blog">All stories <span aria-hidden="true">↗</span></a>
      </div>
      <div class="journal-stories">
        <% recent.forEach(post => { %>
          <article class="journal-story">
            <% const href = '/post/' + encodeURIComponent(post.slug); %>
            <% if (post.image) { %>
              <a href="<%= href %>" class="journal-story-image" tabindex="-1" aria-hidden="true">
                <img src="<%= post.image %>" alt="" loading="lazy" decoding="async">
              </a>
            <% } %>
            <div class="journal-story-body">
              <p class="journal-story-meta"><%= post.category %> <span aria-hidden="true">·</span> <%= post.date %></p>
              <h3><a href="<%= href %>"><%= post.title %></a></h3>
              <p><%= post.content.replace(/\[image:[^\]]*\]/g, '').trim().slice(0, 120) %><%= post.content.length > 120 ? '…' : '' %></p>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (latestPhotos.length) { %>
    <section class="journal-section" aria-labelledby="journal-photos">
      <div class="journal-section-heading">
        <h2 id="journal-photos">From the gallery</h2>
        <a href="/gallery">Open gallery <span aria-hidden="true">↗</span></a>
      </div>
      <div class="journal-photos">
        <% latestPhotos.forEach(photo => { %>
          <% const srcset = gallerySrcset(photo.src); %>
          <a href="/gallery">
            <img src="<%= photo.src %>" <% if (srcset) { %>srcset="<%= srcset %>" sizes="(max-width: 600px) 50vw, 25vw"
              onerror="this.onerror = null; this.removeAttribute('srcset')"<% } %>
              alt="<%= photo.caption || 'Travel photo' %>" loading="lazy" decoding="async">
          </a>
        <% }) %>
      </div>
    </section>
    <% } %>

    <section class="journal-newsletter" aria-labelledby="journal-subscribe">
      <div>
        <h2 id="journal-subscribe">Stay in the loop.</h2>
        <p>New travel stories and food adventures, straight to your inbox.</p>
      </div>
      <div>
        <form method="POST" action="/newsletter" data-newsletter-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="email" name="email" aria-label="Email address" placeholder="Your email address" maxlength="254" required>
          <button type="submit" class="journal-button">Subscribe <span aria-hidden="true">↗</span></button>
        </form>
        <p role="status" data-newsletter-status></p>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script>
    <%- include('partials/dark-toggle-script') %>
    <%- include('partials/newsletter-script') %>
    <%- include('partials/cookie-script') %>
  </script>
  <%- include('partials/cookie-banner') %>
</body>
</html>
