<!DOCTYPE html>
<html lang="en">
<head>
  <script>if(localStorage.getItem('darkMode')==='true')document.documentElement.classList.add('dark');</script>
  <meta charset="UTF-8">
  <meta name="google-site-verification" content="QpMEQmZbbkF7CT-Jn0u6TQALwG0zIakc_le6AdARl7s">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tags — Snap & Snacks</title>
  <meta name="description" content="Browse all tags on Snap & Snacks blog.">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-N9JTYL4795"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-N9JTYL4795');
  </script>

</head>
<body>

  <%- include('partials/nav') %>

  <div class="container">
    <div class="blog-header">
      <h1>🏷️ All Tags</h1>
      <p style="color:var(--muted);font-weight:300">Browse posts by topic</p>
    </div>

    <% if (Object.keys(tagMap).length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">🏷️</div>
        <p>No tags yet.</p>
      </div>
    <% } else { %>
      <div class="tags-grid">
        <% Object.entries(tagMap).sort((a,b) => b[1].length - a[1].length).forEach(([tag, posts]) => { %>
          <a href="/tags/<%= encodeURIComponent(tag) %>" class="tag-card">
            <span class="tag-card-name">#<%= tag %></span>
            <span class="tag-card-count"><%= posts.length %> post<%= posts.length !== 1 ? 's' : '' %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>

  <script>
    <%- include('partials/dark-toggle-script') %>

<%- include('partials/cookie-script') %>

  </script>

<%- include('partials/cookie-banner') %>

</body>
</html>