<!DOCTYPE html>
<html lang="en">
<head>
  <script>if(localStorage.getItem('darkMode')==='true')document.documentElement.classList.add('dark');</script>
  <meta charset="UTF-8">
<meta name="google-site-verification" content="QpMEQmZbbkF7CT-Jn0u6TQALwG0zIakc_le6AdARl7s">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact — Snap & Snacks</title>
  <meta name="description" content="Get in touch with Aswin from Snap & Snack. Send a message or recommendation!">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Contact — Snap & Snacks">
  <meta property="og:description" content="Get in touch with Anish from Snap & Snack.">
  <meta property="og:url" content="https://snapandsnacks.com/contact">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <!-- Google Analytics -->

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-N9JTYL4795"></script>

  <script>

    window.dataLayer = window.dataLayer || [];

    function gtag(){dataLayer.push(arguments);}

    gtag('js', new Date());

    gtag('config', 'G-N9JTYL4795');

  </script>


</head>
<body>

  <%- include('partials/nav', { active: 'contact' }) %>

  <div class="container-sm">
    <div class="contact-header">
      <h1>Get in touch</h1>
      <p>Have a question, a recommendation, or just want to say hi? I'd love to hear from you!</p>
    </div>

    <% if (success) { %>
      <div class="contact-card" style="text-align:center;padding:3rem">
        <div style="font-size:3rem;margin-bottom:1rem">✅</div>
        <h2 style="font-family:var(--serif);margin-bottom:0.5rem">Message sent!</h2>
        <p style="color:var(--muted)">Thanks for reaching out. I'll get back to you soon!</p>
        <a href="/" class="btn btn-accent" style="margin-top:1.5rem">Back to home</a>
      </div>
    <% } else { %>
      <div class="contact-card">
          <form method="POST" action="/contact" onsubmit="var b=this.querySelector('button[type=submit]');b.disabled=true;b.textContent='Sending…';">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label for="contact-name">Your name *</label>
            <input type="text" id="contact-name" name="name" placeholder="Your name" required>
          </div>
          <div class="form-group">
            <label for="contact-email">Email address *</label>
            <input type="email" id="contact-email" name="email" placeholder="you@email.com" required>
          </div>
          <div class="form-group">
            <label for="contact-message">Message *</label>
            <textarea id="contact-message" name="message" rows="6" placeholder="Write your message here..." required></textarea>
          </div>
          <button type="submit" class="btn btn-accent" style="width:100%;padding:0.85rem">Send message →</button>
        </form>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>

  <script>
    <%- include('partials/dark-toggle-script') %>

<%- include('partials/cookie-script') %>

  </script>
<%- include('partials/cookie-banner') %>

</body>
</html>