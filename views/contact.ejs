<!DOCTYPE html>
<html lang="en">
<head>
  <script>if(localStorage.getItem('darkMode')==='true')document.documentElement.classList.add('dark');</script>
  <meta charset="UTF-8">
<meta name="google-site-verification" content="QpMEQmZbbkF7CT-Jn0u6TQALwG0zIakc_le6AdARl7s">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact — Snap & Snacks</title>
  <link rel="canonical" href="<%= siteUrl('/contact') %>">
  <meta name="description" content="Get in touch with Snap &amp; Snacks. Send a question, recommendation, or note.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Contact — Snap & Snacks">
  <meta property="og:description" content="Send a question, recommendation, or note to Snap &amp; Snacks.">
  <meta property="og:url" content="<%= siteUrl('/contact') %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/info-pages.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">


</head>
<body>

  <%- include('partials/nav', { active: 'contact' }) %>

  <main class="info-page contact-info-page">
    <section class="contact-intro" aria-labelledby="contact-title">
      <p class="info-kicker">Contact</p>
      <h1 id="contact-title">Get in touch.</h1>
      <p>Have a question, a recommendation, or just want to say hi? I’d love to hear from you.</p>
      <% const contactPhoto = '/gallery-uploads/rara2.JPG'; %>
      <figure class="contact-photo">
        <img src="<%= contactPhoto %>" alt="Rara Lake, Nepal" decoding="async"
          <%- responsiveImageAttributes(contactPhoto, '(max-width: 760px) calc(100vw - 2rem), 450px') %>>
        <figcaption>Rara Lake, Nepal</figcaption>
      </figure>
    </section>

    <% if (success) { %>
      <section class="contact-card info-contact-card" aria-labelledby="contact-sent-title">
        <h2 id="contact-sent-title">Message sent</h2>
        <p role="status">Thanks for reaching out. I’ll get back to you soon.</p>
        <a href="/" class="btn btn-accent">Back to home</a>
      </section>
    <% } else { %>
      <section class="contact-card info-contact-card" aria-labelledby="contact-form-title">
        <h2 id="contact-form-title">Send a message</h2>
        <p>Leave your email so I can reply.</p>
          <% if (error) { %><p class="alert alert-error" role="alert"><%= error %></p><% } %>
        <form method="POST" action="/contact" onsubmit="var b=this.querySelector('button[type=submit]');b.disabled=true;b.textContent='Sending…';">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="info-contact-fields">
            <div class="form-group">
              <label for="contact-name">Your name</label>
              <input type="text" id="contact-name" name="name" autocomplete="name" placeholder="Your name" value="<%= fields.name || '' %>" maxlength="100" required>
            </div>
            <div class="form-group">
              <label for="contact-email">Email address</label>
              <input type="email" id="contact-email" name="email" autocomplete="email" placeholder="you@example.com" value="<%= fields.email || '' %>" maxlength="254" required>
            </div>
            <div class="form-group contact-message-field">
              <label for="contact-message">Message</label>
              <textarea id="contact-message" name="message" rows="6" placeholder="What’s on your mind?" maxlength="5000" required><%= fields.message || '' %></textarea>
            </div>
          </div>
          <button type="submit" class="btn btn-accent">Send message ↗</button>
          <p class="contact-privacy">See the <a class="info-text-link" href="/privacy">Privacy Policy</a> for how your message is handled.</p>
        </form>
      </section>
    <% } %>
  </main>

  <%- include('partials/footer') %>

  <script>
    <%- include('partials/dark-toggle-script') %>

<%- include('partials/cookie-script') %>

  </script>
<%- include('partials/cookie-banner') %>

</body>
</html>
