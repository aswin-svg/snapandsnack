<button class="back-to-top" id="back-to-top" onclick="scrollToTop()" title="Back to top">↑</button>

<link rel="stylesheet" href="/css/site-footer.css">
<footer class="footer site-footer">
  <div class="container">
    <div class="footer-inner">
      <div>
        <a class="footer-logo" href="/">Snap &amp; <span>Snacks</span></a>
        <p class="footer-desc">Travel, food, and photographs from the road.</p>
      </div>
      <div>
        <h2 class="footer-heading">Explore</h2>
        <div class="footer-links">
          <a href="/blog">All stories</a>
          <% for (const topic of topics) { %>
            <a href="/topics/<%= topic.slug %>"><%= topic.name %></a>
          <% } %>
          <a href="/gallery">Gallery</a>
        </div>
      </div>
      <div>
        <h2 class="footer-heading">About the site</h2>
        <div class="footer-links">
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/archive">Archive</a>
        </div>
      </div>
      <div>
        <h2 class="footer-heading">Legal</h2>
        <div class="footer-links">
          <a href="/privacy">Privacy Policy</a>
          <a href="/terms">Terms & Conditions</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">© <%= new Date().getFullYear() %> Snap &amp; Snacks</div>
  </div>
</footer>
