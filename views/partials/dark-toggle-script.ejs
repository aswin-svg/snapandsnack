const siteNav = document.querySelector('.site-nav');
if (siteNav) {
  const menu = siteNav.querySelector('.site-nav-toggle');
  const panel = siteNav.querySelector('.site-nav-panel');
  const explore = siteNav.querySelector('.site-explore');
  const summary = explore.querySelector('summary');
  const narrow = window.matchMedia('(max-width: 760px)');

  function setMenu(open) {
    menu.setAttribute('aria-expanded', String(open));
    panel.classList.toggle('is-open', open);
    explore.open = open;
  }

  menu.addEventListener('click', () => setMenu(menu.getAttribute('aria-expanded') !== 'true'));
  narrow.addEventListener('change', () => setMenu(false));
  document.addEventListener('click', event => {
    if (!siteNav.contains(event.target)) setMenu(false);
    else if (!narrow.matches && !explore.contains(event.target)) explore.open = false;
  });
  siteNav.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    if (explore.open && explore.contains(event.target)) {
      explore.open = false;
      summary.focus();
    } else if (narrow.matches && menu.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menu.focus();
    } else {
      explore.open = false;
    }
  });
}
window.addEventListener('scroll', () => {
  document.getElementById('back-to-top').classList.toggle('visible', window.scrollY > 300);
});
function scrollToTop() { window.scrollTo({ top: 0, behavior: 'smooth' }); }
function updateDarkToggle(isDark) {
  document.querySelectorAll('.dark-toggle').forEach(el => el.setAttribute('aria-pressed', String(isDark)));
  document.querySelectorAll('.toggle-thumb').forEach(el => el.textContent = isDark ? '🌙' : '☀️');
}
function toggleDark() {
  const isDark = document.documentElement.classList.toggle('dark');
  try { localStorage.setItem('darkMode', isDark); } catch {}
  updateDarkToggle(isDark);
}
updateDarkToggle(document.documentElement.classList.contains('dark'));
