<!DOCTYPE html>
<html lang="en">
  <head>
    <script>if(localStorage.getItem('darkMode')==='true')document.documentElement.classList.add('dark');</script>
  <meta charset="UTF-8">
<meta name="google-site-verification" content="QpMEQmZbbkF7CT-Jn0u6TQALwG0zIakc_le6AdARl7s">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% const pageTitle = (topic?.name || 'Blog') + ' — Snap & Snacks'; %>
  <% const pagePath = topic ? '/topics/' + topic.slug : '/blog'; %>
  <% const description = topic?.description || 'Browse travel, food, and lifestyle stories on Snap & Snacks.'; %>
  <title><%= pageTitle %></title>
  <link rel="canonical" href="<%= siteUrl(pagePath) %>">
  <meta name="description" content="<%= description %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:url" content="<%= siteUrl(pagePath) %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/magazine.css?v=stories">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body class="magazine">

  <%- include('partials/nav', { active: topic?.slug || 'blog' }) %>

  <main class="magazine-wrap">
    <% if (topic) { %>
    <header class="magazine-topic-cover">
      <img src="<%= topic.cover %>" alt="" fetchpriority="high"
        <%- responsiveImageAttributes(topic.cover, storyCoverSizes, true) %>>
      <div>
        <h1><%= topic.name %></h1>
        <p><%= topic.description %></p>
      </div>
    </header>
    <% } else { %>
    <header class="magazine-blog-heading">
      <h1>All stories</h1>
      <p>Travel notes, good meals, and everyday discoveries.</p>
    </header>
    <% } %>

    <div class="blog-filters">
      <% if (topic) { %>
        <a href="/blog" class="filter-btn">All stories</a>
        <% for (const entry of topics) { %>
          <a href="/topics/<%= entry.slug %>" class="filter-btn <%= entry === topic ? 'active' : '' %>"><%= entry.name %></a>
        <% } %>
      <% } else { %>
      <a href="<%= blogFilterUrl('') %>" class="filter-btn <%= activeCategory === '' ? 'active' : '' %>">All categories</a>
      <% categories.forEach(cat => { %>
        <a href="<%= blogFilterUrl(cat) %>" class="filter-btn <%= activeCategory === cat ? 'active' : '' %>"><%= cat %></a>
      <% }) %>
      <% } %>
      <form class="search-box" method="GET" action="<%= pagePath %>">
        <% if (activeCategory && !topic) { %><input type="hidden" name="category" value="<%= activeCategory %>"><% } %>
        <input type="search" name="search" aria-label="Search titles, stories, and tags" placeholder="Search stories or tags" maxlength="200" value="<%= search %>">
        <button type="submit">Search</button>
      </form>
      <% if (search || (activeCategory && !topic)) { %><a href="<%= pagePath %>" class="filter-btn">Clear filters</a><% } %>
    </div>
    <% if (!topic || search) { %><p class="magazine-results"><%= posts.length %> <%= posts.length === 1 ? 'story' : 'stories' %><% if (search) { %> matching “<%= search %>”<% } %></p><% } %>

    <% if (popularTags.length) { %>
      <section class="topic-tags" aria-labelledby="topic-tags-title">
        <h2 id="topic-tags-title">Popular tags</h2>
        <div class="post-tags">
          <% for (const tag of popularTags) { %><a class="tag" href="<%= pagePath %>?search=<%= encodeURIComponent(tag.label) %>">#<%= tag.label %></a><% } %>
        </div>
      </section>
    <% } %>

    <% if (posts.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">🔍</div>
        <p>No posts found<% if (search) { %> for "<%= search %>"<% } %><% if (activeCategory) { %> in <%= activeCategory %><% } %>.</p>
      </div>
    <% } else { %>
      <% if (topic) { %><h2 class="magazine-section-title"><%= search ? 'Search results' : 'Stories' %></h2><% } %>
      <div class="posts-grid magazine-cards">
        <% const stories = featuredPost ? [featuredPost, ...posts.filter(post => post !== featuredPost)] : posts; %>
        <% stories.forEach(post => { %>
          <% const postLink = '/post/' + encodeURIComponent(post.slug); %>
          <article class="post-card">
            <% if (post.image) { %>
              <a href="<%= postLink %>" tabindex="-1" aria-hidden="true"><img src="<%= post.image %>" alt="" class="post-card-img" loading="lazy" decoding="async"
                <%- responsiveImageAttributes(post.image, '(max-width: 640px) calc(100vw - 2rem), (max-width: 950px) 44vw, 480px') %>></a>
            <% } else { %>
              <div class="post-card-img-placeholder" aria-hidden="true">📷</div>
            <% } %>
            <div class="post-card-body">
              <p class="magazine-kicker"><%= post === featuredPost ? 'Featured story' : post.category %></p>
              <h3><a href="<%= postLink %>"><%= post.title %></a></h3>
              <% const excerpt = post.content.replace(/\[image:[^\]]*\]/g, '').trim(); %>
              <p class="post-card-excerpt"><%= excerpt.slice(0, 130) %><%= excerpt.length > 130 ? '…' : '' %></p>
              <% if (post.tags?.length) { %>
                <div class="post-tags" style="margin-bottom:0.75rem">
                  <% (post.tags || []).slice(0,3).forEach(t => { %><a href="/tags/<%= encodeURIComponent(t) %>" class="tag">#<%= t %></a><% }) %>
                </div>
              <% } %>
              <div class="post-card-footer">
                <span class="post-date"><%= post.date %></span>
                <span class="post-read-time">⏱️ <%= Math.max(1, Math.round(post.content.split(/\s+/).length / 200)) %> min read</span>
                <a href="<%= postLink %>" class="post-link" aria-label="Read <%= post.title %>">Read →</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </main>

  <!-- Back to top -->
  <%- include('partials/footer') %>

  <script>
    <%- include('partials/dark-toggle-script') %>

<%- include('partials/cookie-script') %>

  </script>

<%- include('partials/cookie-banner') %>

</body>
</html>
