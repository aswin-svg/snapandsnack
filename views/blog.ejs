<!DOCTYPE html>
<html lang="en">
  <head>
    <script>if(localStorage.getItem('darkMode')==='true')document.documentElement.classList.add('dark');</script>
  <meta charset="UTF-8">
<meta name="google-site-verification" content="QpMEQmZbbkF7CT-Jn0u6TQALwG0zIakc_le6AdARl7s">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blog — Snap & Snacks</title>
  <meta name="description" content="Browse all travel, food and lifestyle posts on Snap & Snack. Real stories from real trips.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Blog — Snap & Snack">
  <meta property="og:description" content="Browse all travel, food and lifestyle posts on Snap & Snack.">
  <meta property="og:url" content="https://snapandsnacks.com/blog">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-N9JTYL4795"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-N9JTYL4795');
  </script>
</head>
<body>

  <%- include('partials/nav', { active: 'blog' }) %>

  <div class="container">
    <div class="blog-header">
      <h1>All Posts</h1>
      <p style="color:var(--muted);font-weight:300"><%= posts.length %> article<%= posts.length !== 1 ? 's' : '' %></p>
    </div>

    <div class="blog-filters">
      <a href="/blog" class="filter-btn <%= activeCategory === '' && search === '' ? 'active' : '' %>">All</a>
      <% categories.forEach(cat => { %>
        <a href="/blog?category=<%= cat %>" class="filter-btn <%= activeCategory === cat ? 'active' : '' %>"><%= cat %></a>
      <% }) %>
      <form class="search-box" method="GET" action="/blog">
        <input type="text" name="search" placeholder="Search posts..." value="<%= search %>">
        <button type="submit">Search</button>
      </form>
    </div>

    <% if (posts.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">🔍</div>
        <p>No posts found<% if (search) { %> for "<%= search %>"<% } %><% if (activeCategory) { %> in <%= activeCategory %><% } %>.</p>
        <a href="/blog" class="btn btn-outline">Clear filters</a>
      </div>
    <% } else { %>
      <div class="posts-grid" style="padding-bottom:4rem">
        <% posts.forEach(post => { %>
          <article class="post-card">
            <% if (post.image) { %>
              <a href="/post/<%= post.slug %>"><img src="<%= post.image %>" alt="<%= post.title %>" class="post-card-img" loading="lazy"></a>
            <% } else { %>
              <a href="/post/<%= post.slug %>"><div class="post-card-img-placeholder">📷</div></a>
            <% } %>
            <div class="post-card-body">
              <span class="cat-badge cat-<%= post.category.toLowerCase() %>"><%= post.category %></span>
              <h3><a href="/post/<%= post.slug %>"><%= post.title %></a></h3>
              <p class="post-card-excerpt"><%= post.content.substring(0, 130) %>...</p>
              <% if (post.tags.length > 0) { %>
                <div class="post-tags" style="margin-bottom:0.75rem">
                  <% post.tags.slice(0,3).forEach(t => { %><span class="tag">#<%= t %></span><% }) %>
                </div>
              <% } %>
              <div class="post-card-footer">
                <span class="post-date"><%= post.date %></span>
                <span class="post-read-time">⏱️ <%= Math.max(1, Math.round(post.content.split(/\s+/).length / 200)) %> min read</span>
                <a href="/post/<%= post.slug %>" class="post-link">Read →</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Back to top -->
  <%- include('partials/footer') %>

  <script>
    <%- include('partials/dark-toggle-script') %>

<%- include('partials/cookie-script') %>

  </script>

<%- include('partials/cookie-banner') %>

</body>
</html>
