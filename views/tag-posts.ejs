<!DOCTYPE html>
<html lang="en">
<head>
  <script>if(localStorage.getItem('darkMode')==='true')document.documentElement.classList.add('dark');</script>
  <meta charset="UTF-8">
  <meta name="google-site-verification" content="QpMEQmZbbkF7CT-Jn0u6TQALwG0zIakc_le6AdARl7s">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>#<%= tag %> — Snap & Snacks</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-N9JTYL4795"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-N9JTYL4795');
  </script>

</head>
<body>

  <%- include('partials/nav') %>

  <div class="container">
    <a href="/tags" class="back-link">← All tags</a>

    <div class="blog-header">
      <h1>#<%= tag %></h1>
      <p style="color:var(--muted);font-weight:300"><%= posts.length %> post<%= posts.length !== 1 ? 's' : '' %> tagged with #<%= tag %></p>
    </div>

    <% if (posts.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">🔍</div>
        <p>No posts found with this tag.</p>
        <a href="/blog" class="btn btn-accent">Browse all posts</a>
      </div>
    <% } else { %>
      <div class="posts-grid" style="padding-bottom:4rem">
        <% posts.forEach(post => { %>
          <article class="post-card">
            <% if (post.image) { %>
              <a href="/post/<%= post.slug %>"><img src="<%= post.image %>" alt="<%= post.title %>" class="post-card-img"></a>
            <% } else { %>
              <a href="/post/<%= post.slug %>"><div class="post-card-img-placeholder">📷</div></a>
            <% } %>
            <div class="post-card-body">
              <span class="cat-badge cat-<%= post.category.toLowerCase() %>"><%= post.category %></span>
              <h3><a href="/post/<%= post.slug %>"><%= post.title %></a></h3>
              <p class="post-card-excerpt"><%= post.content.substring(0,120) %>...</p>
              <div class="post-card-footer">
                <span class="post-date"><%= post.date %></span>
                <a href="/post/<%= post.slug %>" class="post-link">Read →</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>

  <script>
    <%- include('partials/dark-toggle-script') %>

<%- include('partials/cookie-script') %>

  </script>

<%- include('partials/cookie-banner') %>


</body>
</html>